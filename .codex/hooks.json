{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && /usr/bin/env python3 \"$ROOT/.codex/hooks/loop_research_stop.py\" || true",
            "timeout": 30,
            "statusMessage": "Checking loop research progress"
          }
        ]
      }
    ]
  }
}
