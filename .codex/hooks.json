{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && /usr/bin/env python3 \"$ROOT/.codex/hooks/docguard_stop.py\" || true",
            "timeout": 30,
            "statusMessage": "Checking documentation drift"
          }
        ]
      }
    ]
  }
}
